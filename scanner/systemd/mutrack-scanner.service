[Unit]
Description=MuTrack BLE Beacon Scanner
Documentation=https://github.com/your-repo/mutrack
After=network.target bluetooth.target
Wants=bluetooth.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/mutrack-scanner
ExecStart=/home/pi/mutrack-scanner/venv/bin/python -m mutrack_scanner --config /home/pi/mutrack-scanner/config.yaml
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/pi/mutrack-scanner

# Resource limits
MemoryMax=256M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
