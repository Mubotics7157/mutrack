# Ballistics Backend Configuration

# Convex deployment URL (e.g., https://your-deployment.convex.cloud)
BALLISTICS_CONVEX_URL=

# ML Worker API key (generated from admin UI)
BALLISTICS_ML_WORKER_API_KEY=

# Worker identification
BALLISTICS_WORKER_NAME=local-worker

# Polling settings
BALLISTICS_POLL_INTERVAL_SECONDS=5.0
BALLISTICS_MAX_RETRIES=3

# Model paths (optional - will download defaults)
# BALLISTICS_YOLO_MODEL=yolov8n.pt
# BALLISTICS_DEPTH_MODEL=depth-anything/Depth-Anything-V2-Small-hf

# Processing settings
BALLISTICS_DETECTION_CONFIDENCE=0.5
BALLISTICS_TRACKING_CONFIDENCE=0.3
BALLISTICS_MAX_FRAMES=1000

# Physics defaults
BALLISTICS_BALL_DIAMETER=0.24
BALLISTICS_BALL_MASS=0.27
BALLISTICS_AIR_DENSITY=1.225
BALLISTICS_GRAVITY=9.81
